# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Logs / temp
*.log
*.tmp

# Keep assets/screenshots/web (optimized web images) but ignore the raw originals
assets/screenshots/*.jpg
assets/screenshots/*.mp4
assets/screenshots/*.png

# impeccable design-linter — keep shared ignore config, drop transient cache + local overrides
.impeccable/hook.cache.json
.impeccable/config.local.json

# Reference docs (local use only, not part of the deployed site)
# netlify.toml sets publish = "." so ANY committed file at the repo root is
# publicly fetchable — /assets/blog/IMAGE-CREDITS.md and /social/*.md both
# return HTTP 200 today (checked 2026-07-30). Internal planning docs must
# therefore stay out of the commit, not merely out of the nav.
BLOG_CONTENT_STRATEGY.md
CURRENT_FEATURES.md
WEBSITE_REFERENCE.md
BLOG-PUSH-PRIORITY.md
BLOG_WORKFLOW.md
indexing-url-list.txt
tester-update-email.html
